{
  "name": "experiment-doctor",
  "version": "0.1.0",
  "description": "Find out why your Flagsmith experiment is flatlining. Diagnose, fix with approval, and verify.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "experiment-doctor": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@experiment-doctor/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
