# Copy to .env.local for local development. Everything is optional: without these the
# game runs with an in-memory store and a local A/B split.

# Public site URL, used for share links and Open Graph images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Flagsmith client-side environment key for the Human vs Doctor experiment (public)
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_ID=
# Only for self-hosted Flagsmith
NEXT_PUBLIC_FLAGSMITH_API_URL=
NEXT_PUBLIC_FLAGSMITH_EVENTS_URL=

# Server-only: read live experiment results for the Rescue Center
FLAGSMITH_API_KEY=
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_EXPERIMENT_ID=

# Supabase project for sessions and the leaderboard (see supabase/schema.sql)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 16+ random characters, signs challenge sessions
SESSION_SECRET=
